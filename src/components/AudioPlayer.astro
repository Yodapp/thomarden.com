---
import type { Track } from '@/data/album';

type Props = {
  tracks: Track[];
  fallbackArtwork: string;
};

const { tracks, fallbackArtwork } = Astro.props;
const playableTracks = tracks.map((track) => ({
  number: track.number,
  title: track.title,
  audioUrl: track.audioUrl,
  coverImage: track.coverImage
}));
---

<section
  class="audio-player"
  data-audio-player
  data-tracks={JSON.stringify(playableTracks)}
  data-fallback-artwork={fallbackArtwork}
  style={`--track-artwork: url('${tracks[0]?.coverImage ?? fallbackArtwork}')`}
>
  <div class="player-main">
    <a
      class="artwork-trigger player-artwork-trigger"
      data-artwork-link
      href={`#artwork-track-${tracks[0]?.number ?? 1}`}
      aria-label={`Open ${tracks[0]?.title ?? 'selected track'} cover`}
      aria-haspopup="dialog"
    >
      <img
        class="player-artwork"
        data-artwork
        src={tracks[0]?.coverImage ?? fallbackArtwork}
        alt={`${tracks[0]?.title ?? 'Selected track'} cover`}
        width="96"
        height="96"
      />
    </a>
    <div class="player-copy">
      <p class="player-title" data-title>{tracks[0]?.title ?? 'Select a track'}</p>
      <p class="player-subtitle" data-subtitle>
        {tracks[0]?.audioUrl ? 'Full track' : 'Audio unavailable'}
      </p>
    </div>
    <button class="play-button" type="button" data-play aria-label="Play selected track" aria-pressed="false">
      <svg class="control-icon control-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
      <svg class="control-icon control-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5.5h3.25v13H7.5zm5.75 0h3.25v13h-3.25z" /></svg>
    </button>
  </div>

  <div class="player-modes" aria-label="Playback modes">
    <button class="player-mode-button" type="button" data-shuffle aria-label="Turn shuffle on" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3.2c2.4 0 3.7 1.2 5.2 4s2.8 4 5.2 4H20m-3-3 3 3-3 3M4 17h3.2c1.3 0 2.3-.4 3.1-1.2M17 6l3 3-3 3M14.1 8.2c.8-.8 1.8-1.2 3.1-1.2H20" /></svg>
      <span>Shuffle</span>
    </button>
    <button class="player-mode-button" type="button" data-repeat data-repeat-mode="off" aria-label="Repeat is off. Activate repeat all">
      <svg class="repeat-icon repeat-icon-all" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h11a4 4 0 0 1 4 4v1m-3-3 3 3-3 3M20 17H9a4 4 0 0 1-4-4v-1m3 3-3-3 3-3" /></svg>
      <svg class="repeat-icon repeat-icon-one" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h11a4 4 0 0 1 4 4v1m-3-3 3 3-3 3M20 17H9a4 4 0 0 1-4-4v-1m3 3-3-3 3-3" /><text x="12" y="15.3">1</text></svg>
      <span data-repeat-label>Repeat off</span>
    </button>
  </div>

  <div class="player-visualizer" aria-hidden="true">
    {
      [42, 68, 86, 58, 94, 72, 48, 82, 100, 64, 88, 54, 76, 96, 62, 84, 46, 70].map(
        (height, index) => (
          <span
            style={`--bar-height: ${height}%; --bar-duration: ${0.72 + (index % 5) * 0.11}s; --bar-delay: -${(index * 0.13) % 0.8}s`}
          />
        )
      )
    }
  </div>

  <div class="progress">
    <span data-current>0:00</span>
    <input data-progress type="range" min="0" max="100" value="0" aria-label="Track progress" />
    <span data-duration>0:00</span>
  </div>

  <audio data-audio preload="metadata"></audio>
</section>

<script>
  // @ts-nocheck
  const formatTime = (seconds) => {
    if (!Number.isFinite(seconds)) return '0:00';
    const minutes = Math.floor(seconds / 60);
    const rest = Math.floor(seconds % 60).toString().padStart(2, '0');
    return `${minutes}:${rest}`;
  };

  document.querySelectorAll('[data-audio-player]').forEach((player) => {
    const tracks = JSON.parse(player.getAttribute('data-tracks') || '[]');
    const audio = player.querySelector('[data-audio]');
    const playButton = player.querySelector('[data-play]');
    const title = player.querySelector('[data-title]');
    const subtitle = player.querySelector('[data-subtitle]');
    const progress = player.querySelector('[data-progress]');
    const current = player.querySelector('[data-current]');
    const duration = player.querySelector('[data-duration]');
    const artwork = player.querySelector('[data-artwork]');
    const artworkTrigger = player.querySelector('[data-artwork-link]');
    const shuffleButton = player.querySelector('[data-shuffle]');
    const repeatButton = player.querySelector('[data-repeat]');
    const repeatLabel = player.querySelector('[data-repeat-label]');
    const fallbackArtwork = player.getAttribute('data-fallback-artwork') || '';
    const trackButtons = document.querySelectorAll('[data-track-play]');
    let selected = tracks[0];
    let shuffleEnabled = false;
    let repeatMode = 'off';
    let shuffleQueue = [];

    const setPlayControlState = (button, isPlaying, track) => {
      button.classList.toggle('is-playing', isPlaying);
      button.setAttribute('aria-pressed', String(isPlaying));
      button.setAttribute('aria-label', `${isPlaying ? 'Pause' : 'Play'} ${track?.title || 'selected track'}`);
    };

    const updateTrackState = () => {
      const playerIsPlaying = Boolean(selected && !audio.paused && !audio.ended);
      player.classList.toggle('is-playing', playerIsPlaying);
      playButton.setAttribute('aria-label', playerIsPlaying ? 'Pause selected track' : 'Play selected track');

      trackButtons.forEach((button) => {
        const index = Number(button.getAttribute('data-track-play'));
        const isSelected = tracks[index]?.number === selected?.number;
        const isPlaying = isSelected && playerIsPlaying;
        const row = button.closest('[data-track-row]');

        row?.classList.toggle('is-selected', isSelected);
        row?.classList.toggle('is-playing', isPlaying);
        setPlayControlState(button, isPlaying, tracks[index]);
      });

      setPlayControlState(playButton, !audio.paused, selected);
    };

    const shuffle = (items) => {
      const shuffled = [...items];
      for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
      }
      return shuffled;
    };

    const resetShuffleQueue = () => {
      shuffleQueue = shuffle(tracks.filter((track) => track.audioUrl && track.number !== selected?.number));
    };

    const updateModeControls = () => {
      shuffleButton.classList.toggle('is-active', shuffleEnabled);
      shuffleButton.setAttribute('aria-pressed', String(shuffleEnabled));
      shuffleButton.setAttribute('aria-label', shuffleEnabled ? 'Turn shuffle off' : 'Turn shuffle on');

      repeatButton.dataset.repeatMode = repeatMode;
      repeatLabel.textContent = repeatMode === 'all' ? 'Repeat all' : repeatMode === 'one' ? 'Repeat one' : 'Repeat off';
      repeatButton.setAttribute(
        'aria-label',
        repeatMode === 'off'
          ? 'Repeat is off. Activate repeat all'
          : repeatMode === 'all'
            ? 'Repeat all is on. Activate repeat one'
            : 'Repeat one is on. Turn repeat off'
      );
    };

    const updateArtwork = (track) => {
      if (!artwork) return;
      const imageUrl = track.coverImage || fallbackArtwork;
      const artworkTitle = `${track.title} cover`;
      artwork.onerror = () => {
        artwork.onerror = null;
        artwork.src = fallbackArtwork;
        player.style.setProperty('--track-artwork', `url('${fallbackArtwork}')`);
      };
      artwork.src = imageUrl;
      artwork.alt = artworkTitle;
      artworkTrigger?.setAttribute('href', `#artwork-track-${track.number}`);
      artworkTrigger?.setAttribute('aria-label', `Open ${track.title} cover`);
      player.style.setProperty('--track-artwork', `url('${imageUrl}')`);
    };

    const loadTrack = (track, { resetShuffle = true } = {}) => {
      selected = track;
      if (shuffleEnabled && resetShuffle) resetShuffleQueue();
      title.textContent = track.title;
      updateArtwork(track);
      if (!track.audioUrl) {
        audio.removeAttribute('src');
        audio.load();
        subtitle.textContent = 'Audio unavailable';
        progress.value = 0;
        current.textContent = '0:00';
        duration.textContent = '0:00';
        updateTrackState();
        return false;
      }

      audio.src = track.audioUrl;
      audio.load();
      subtitle.textContent = `Track ${track.number}`;
      progress.value = 0;
      current.textContent = '0:00';
      duration.textContent = '0:00';
      updateTrackState();
      return true;
    };

    const getNextTrack = () => {
      if (repeatMode === 'one') return selected;

      if (shuffleEnabled) {
        if (!shuffleQueue.length && repeatMode === 'all') resetShuffleQueue();
        return shuffleQueue.shift() || null;
      }

      const selectedIndex = tracks.findIndex((track) => track.number === selected?.number);
      const maximumOffset = repeatMode === 'all' ? tracks.length : tracks.length - selectedIndex - 1;
      for (let offset = 1; offset <= maximumOffset; offset += 1) {
        const track = tracks[(selectedIndex + offset) % tracks.length];
        if (track?.audioUrl) return track;
      }
      return null;
    };

    const playNextTrack = async () => {
      const nextTrack = getNextTrack();
      if (!nextTrack || !loadTrack(nextTrack, { resetShuffle: false })) {
        updateTrackState();
        return;
      }

      try {
        await audio.play();
        updateTrackState();
      } catch {
        subtitle.textContent = 'Playback was blocked. Try pressing play again.';
      }
    };

    loadTrack(selected);
    updateModeControls();

    shuffleButton.addEventListener('click', () => {
      shuffleEnabled = !shuffleEnabled;
      if (shuffleEnabled) resetShuffleQueue();
      else shuffleQueue = [];
      updateModeControls();
    });

    repeatButton.addEventListener('click', () => {
      repeatMode = repeatMode === 'off' ? 'all' : repeatMode === 'all' ? 'one' : 'off';
      updateModeControls();
    });

    document.querySelectorAll('[data-track-play]').forEach((button) => {
      button.addEventListener('click', async () => {
        const index = Number(button.getAttribute('data-track-play'));
        const track = tracks[index];
        if (!track) return;

        if (selected?.number === track.number && !audio.paused) {
          audio.pause();
          return;
        }

        if (selected?.number !== track.number && !loadTrack(track)) return;

        try {
          await audio.play();
          updateTrackState();
        } catch {
          subtitle.textContent = 'Playback was blocked. Try pressing play again.';
        }
      });
    });

    playButton.addEventListener('click', async () => {
      if (!selected?.audioUrl) {
        subtitle.textContent = 'Audio unavailable';
        return;
      }

      if (audio.paused) {
        try {
          await audio.play();
          updateTrackState();
        } catch {
          subtitle.textContent = 'Playback was blocked. Try pressing play again.';
        }
      } else {
        audio.pause();
        updateTrackState();
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      duration.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      current.textContent = formatTime(audio.currentTime);
      progress.value = audio.duration ? String((audio.currentTime / audio.duration) * 100) : '0';
    });

    audio.addEventListener('ended', () => {
      playNextTrack();
    });

    audio.addEventListener('pause', updateTrackState);
    audio.addEventListener('play', updateTrackState);

    progress.addEventListener('input', () => {
      if (!audio.duration) return;
      audio.currentTime = (Number(progress.value) / 100) * audio.duration;
    });
  });
</script>
